# ---- Core -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Embedded PostgreSQL (WASM) for local/dev; use a real PostgreSQL in production.
DATABASE_URL=pglite://.data/yesi
# DATABASE_URL=postgresql://yesi:secret@127.0.0.1:5432/yesi
APP_ORIGIN=http://localhost:3000

# Encrypts connector credentials and TOTP seeds at rest. 32 bytes, base64.
MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MASTER_KEY_ID=k1
SESSION_MINUTES=30

# ---- Identity ---------------------------------------------------------------
AUTH_MODE=local                 # local (demo) | oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---- Connectors -------------------------------------------------------------
CONNECTORS_MODE=sandbox         # sandbox | live
ALLOW_LIVE_CONNECTORS=false     # requires marketplace certification
CONNECTOR_POLL_INTERVAL_MS=45000
WEBHOOK_TOLERANCE_SECONDS=300

# ---- Adjacent systems -------------------------------------------------------
ERP_ENDPOINT=
ERP_SECRET=
TMS_ENDPOINT=
TMS_SECRET=
TMS_WEBHOOK_SECRET=

# ---- Operations -------------------------------------------------------------
METRICS_TOKEN=
REDIS_URL=
WORKER_ENABLED=true
AUTO_SEED=true
