{
  "name": "yesi-fulfillment-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:check": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "worker": "tsx server/worker.ts",
    "migrate": "tsx server/migrate.ts",
    "seed": "tsx server/seed.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "reset": "rm -rf .data && npm run migrate && npm run seed"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@tanstack/react-virtual": "^3.13.12",
    "dotenv": "^18.0.10",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "openid-client": "^6.8.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^25.0.1",
    "node": "^22.23.5",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  },
  "description": "Event-driven fulfillment platform for Ozon, Yandex Market and Wildberries"
}
